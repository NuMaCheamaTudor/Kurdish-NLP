{
  "version": "sorani-ner-v2.0",
  "seed": 1729,
  "tag_mapping": {"B-POLITICAL_PARY": "B-POLITICAL_PARTY", "I-POLITICAL_PARY": "I-POLITICAL_PARTY", "o": "O"},
  "conflict_policy": "quarantine_all_raw_exact_text_annotation_variants",
  "bio_policy": "quarantine_all_remaining_invalid_sequences_no_inferred_repairs",

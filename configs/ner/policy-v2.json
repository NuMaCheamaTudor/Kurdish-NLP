  "long_segment_policy": "flag_and_retain_use_transformer_windows",
  "deduplication": "exact_original_token_sequence_after_conflict_quarantine",
  "near_jaccard": 0.85,
  "near_min_tokens": 8,
  "near_shingle_width": 3,
  "split_ratios": {"train": 0.8, "dev": 0.1, "test": 0.1},
  "insufficient_train_entities": 50,
  "insufficient_eval_entities": 20
}

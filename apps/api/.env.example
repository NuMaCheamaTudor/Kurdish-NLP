# Copy to apps/api/.env to override defaults. Relative paths resolve from the repository root.

# Directory holding the frozen experiment (tfidf_lr/, fasttext/, selection.lock.json).
KNLP_ARTIFACTS_DIR=artifacts/langid/experiments/baseline-v1
# Language ID model used when a request does not name one: tfidf_lr or fasttext.
KNLP_DEFAULT_MODEL=tfidf_lr

# spaCy pipelines. Leave empty to disable. Unavailable until spaCy and the full weights are present.
KNLP_NER_MODEL_PATH=kurdish-ner-v1
KNLP_GRAMMAR_MODEL_PATH=kurdish-pos-output (1)/model-best

KNLP_MAX_TEXT_CHARS=5000
KNLP_INFERENCE_CONCURRENCY=4
# Load models at startup (true) or on first request (false).
KNLP_PRELOAD=true
# Comma-separated explicit origins; '*' is rejected.
KNLP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
